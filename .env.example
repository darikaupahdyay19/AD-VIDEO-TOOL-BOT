# ----------------------------------------------------------------------------
# Telegram / Pyrogram credentials (required)
# ----------------------------------------------------------------------------
# Obtain API_ID and API_HASH from https://my.telegram.org -> API development tools
API_ID=0
API_HASH=
# Bot token from @BotFather
BOT_TOKEN=
# Pyrogram session name (a <name>.session file is created next to the app)
SESSION_NAME=video_tool_bot
# Number of Pyrogram update-handling workers
WORKERS=8

# ----------------------------------------------------------------------------
# MongoDB (required)
# ----------------------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=video_tool_bot

# ----------------------------------------------------------------------------
# Access control
# ----------------------------------------------------------------------------
# Telegram user id of the bot owner
OWNER_ID=0
# Space or comma separated list of additional admin user ids
ADMIN_IDS=
# Optional channel for logging (numeric id, e.g. -1001234567890)
LOG_CHANNEL=0

# ----------------------------------------------------------------------------
# Storage and limits
# ----------------------------------------------------------------------------
DOWNLOAD_DIR=downloads
# Maximum input file size in bytes (default 2 GiB)
MAX_FILE_SIZE=2147483648
# Per-job FFmpeg timeout in seconds (default 2 hours)
TASK_TIMEOUT=7200
# Maximum concurrent FFmpeg jobs across all users
MAX_CONCURRENT_TASKS=2
# Maximum queued tasks per user
MAX_TASKS_PER_USER=5

# ----------------------------------------------------------------------------
# Rate limiting / flood protection
# ----------------------------------------------------------------------------
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=20

# ----------------------------------------------------------------------------
# Misc
# ----------------------------------------------------------------------------
# Seconds between live progress-message edits
PROGRESS_UPDATE_INTERVAL=5
LOG_LEVEL=INFO
BOT_NAME=Video Tool Bot
SUPPORT_CHAT=
